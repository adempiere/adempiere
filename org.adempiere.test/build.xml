<?xml version="1.0" encoding="UTF-8"?>
<!-- ================================================ -->
<!-- org.adempiere.test Scala specs build           -->
<!-- ================================================ -->
<!-- Compiles and runs the ScalaTest specs of this module.

     Opt-in targets, invoked from the repository root:
       ant -f utils_dev/build.xml scala-compile
       ant -f utils_dev/build.xml scala-test

     scala-test runs only the no-database suite by default. Nine of the ten specs here
     mix in AdempiereTestCase, whose beforeAll performs a batchLogin against a live
     PostgreSQL, so they need a restored instance and must be named explicitly:
       ant -f utils_dev/build.xml scala-test -Dscala.test.suites=org.eevolution.test.CreateSalesOrder
     Several comma-separated suites are allowed; the value is passed as repeated -s flags.

     The java/ant build (main.yml, build_with_gradle.yml) never compiles
     scala sources, so broken specs merged silently (see adempiere#4431).
     These targets close that gap without touching the existing build chain.

     Prerequisite: the java classes the specs import must be compiled first:
       ant -f utils_dev/build.xml jar
-->
<project name="adempiere-test-scala" default="scala-compile" basedir=".">

  <!-- Pinned toolchain: Scala 3.3.1 + ScalaTest 3.2.10 (matches build.sbt) -->
  <property name="scala.version" value="3.3.1"/>
  <property name="scalatest.version" value="3.2.10"/>
  <property name="scala-asm.version" value="9.5.0-scala-1"/>
  <property name="scala-library.version" value="2.13.10"/>

  <property name="scala.deps.dir" location="${basedir}/.scala-deps"/>
  <property name="scala.main.classes" location="${basedir}/build/scala-classes"/>
  <property name="scala.test.classes" location="${basedir}/build/scala-test-classes"/>

  <!-- Local overrides (machine-specific paths), same convention as utils_dev/properties.xml -->
  <property file="../utils_dev/mytest.properties"/>

  <property name="maven.central" value="https://repo1.maven.org/maven2"/>

  <!-- JDK for dotc and the test JVM, matching the java build (release 11).
       Override with -Dscala.java.home=/path/to/jdk -->
  <property name="scala.java.home" value="${java.home}"/>
  <condition property="scala.java.bin" value="${scala.java.home}/bin" else="${java.home}/bin">
    <available file="${scala.java.home}/bin/java"/>
  </condition>

  <!-- Java classes the specs run against: the in-tree module build dirs produced by
       the ant chain (base, extend, asset, manufacturing, distribution, warehouse,
       client), plus the module jars the chain copies into lib/.
       CCTools/CSTools carry org.adempiere.legacy.apache.ecs, needed by the report
       processes (ProcessBuilder.execute).
       Override with -Dscala.app.classes=/path/to/runtime/bin:/path/to/Adempiere.jar -->
  <property name="scala.app.classes"
            value="${basedir}/../base/build:${basedir}/../extend/build:${basedir}/../org.adempiere.asset/build:${basedir}/../org.eevolution.manufacturing/build:${basedir}/../org.eevolution.distribution/build:${basedir}/../org.eevolution.warehouse/build:${basedir}/../org.eevolution.freight/build:${basedir}/../client/build:${basedir}/../JasperReports/build:${basedir}/../lib/customization.jar:${basedir}/../lib/CCTools.jar:${basedir}/../lib/CSTools.jar"/>

  <!-- Adempiere runtime properties for the test JVM. The scala-test target
       copies the committed template to this gitignored working file (Ini.saveProperties
       rewrites the loaded file with machine-specific values). Override the whole
       file with -Dscala.test.propertyfile=/path/to/Adempiere.properties -->
  <property name="scala.test.template" location="${basedir}/AdempiereEnv.template.properties"/>
  <property name="scala.test.propertyfile" location="${basedir}/build/scala-test/Adempiere.properties"/>

  <!-- ScalaTest suites for scala-test. Override with -Dscala.test.suites=a.b.C,d.e.F.
       The default is deliberately the one spec that needs no database: an empty value
       makes the ScalaTest Runner discover every suite on the runpath, and nine of the
       ten specs here mix in AdempiereTestCase, whose beforeAll calls Login.batchLogin
       against a live PostgreSQL. A bare "ant -f utils_dev/build.xml scala-test" would
       then fail on login instead of reporting results, so discovery is never the default. -->
  <property name="scala.test.suites" value="org.eevolution.test.ValidateInvoiceHistoryOrderSqlSpacing"/>

  <!-- App server type for the test JVM. Adempiere.startup(false) runs in server
       mode, whose DB_PostgreSQL.getDataSource requires ADEMPIERE_APPS_TYPE to be
       set; any non-wildfly value makes it build a standalone Hikari pool directly
       from the Connection URL (no JNDI / app server needed). -->
  <property name="scala.test.apps.type" value="standalone"/>

  <!-- App home holding the prebuilt module jars some ad_modelvalidator rows need.
       Resolved in order: explicit -Dscala.adempiere.home, then $ADEMPIERE_HOME,
       then the install output of this checkout, then the install output of the
       checkout that owns this linked worktree (install/ is gitignored, so a
       worktree under .worktrees/ carries no copy of its own). Every fileset using
       it is guarded, so a tree with none of these still runs.
       Resolved with a <condition> cascade, not repeated <property> elements: in Ant
       the first <property> wins even when its value cannot be resolved, so an unset
       ${env.ADEMPIERE_HOME} would freeze this to the literal "${env.ADEMPIERE_HOME}"
       and silently hide every fallback, leaving the validator jars off the classpath
       and Login.batchLogin returning false with no error. Each step here is tested
       before it is adopted. -->
  <condition property="scala.adempiere.home" value="${env.ADEMPIERE_HOME}">
    <and>
      <isset property="env.ADEMPIERE_HOME"/>
      <available file="${env.ADEMPIERE_HOME}/packages" type="dir"/>
    </and>
  </condition>
  <condition property="scala.adempiere.home" value="${basedir}/../install/build/Adempiere">
    <available file="${basedir}/../install/build/Adempiere/packages" type="dir"/>
  </condition>
  <condition property="scala.adempiere.home" value="${basedir}/../../install/build/Adempiere">
    <available file="${basedir}/../../install/build/Adempiere/packages" type="dir"/>
  </condition>
  <!-- A linked worktree two levels below the checkout (<checkout>/.worktrees/<name>)
       reaches its install output from three levels up. -->
  <condition property="scala.adempiere.home" value="${basedir}/../../../install/build/Adempiere">
    <available file="${basedir}/../../../install/build/Adempiere/packages" type="dir"/>
  </condition>

  <target name="scala-init">
    <mkdir dir="${scala.deps.dir}"/>
    <mkdir dir="${scala.main.classes}"/>
    <mkdir dir="${scala.test.classes}"/>
  </target>

  <!-- Fetch pinned jars from Maven Central (idempotent). -->
  <target name="scala-deps" depends="scala-init" description="Download pinned Scala and ScalaTest jars">
    <get src="${maven.central}/org/scala-lang/scala3-compiler_3/${scala.version}/scala3-compiler_3-${scala.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scala-lang/scala3-library_3/${scala.version}/scala3-library_3-${scala.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scala-lang/scala3-interfaces/${scala.version}/scala3-interfaces-${scala.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scala-lang/tasty-core_3/${scala.version}/tasty-core_3-${scala.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scala-lang/modules/scala-asm/${scala-asm.version}/scala-asm-${scala-asm.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scala-lang/scala-library/${scala-library.version}/scala-library-${scala-library.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scalatest/scalatest_3/${scalatest.version}/scalatest_3-${scalatest.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scalatest/scalatest-core_3/${scalatest.version}/scalatest-core_3-${scalatest.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scalatest/scalatest-featurespec_3/${scalatest.version}/scalatest-featurespec_3-${scalatest.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scalatest/scalatest-compatible/${scalatest.version}/scalatest-compatible-${scalatest.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scalactic/scalactic_3/${scalatest.version}/scalactic_3-${scalatest.version}.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
    <get src="${maven.central}/org/scala-lang/modules/scala-xml_3/2.1.0/scala-xml_3-2.1.0.jar"
         dest="${scala.deps.dir}" skipexisting="true"/>
  </target>

  <path id="scala.compiler.path">
    <fileset dir="${scala.deps.dir}">
      <include name="scala3-compiler_3-*.jar"/>
      <include name="scala3-library_3-*.jar"/>
      <include name="scala3-interfaces-*.jar"/>
      <include name="tasty-core_3-*.jar"/>
      <include name="scala-asm-*.jar"/>
      <include name="scala-library-*.jar"/>
    </fileset>
  </path>

  <path id="scala.app.path">
    <pathelement path="${scala.app.classes}"/>
    <fileset dir="${basedir}/../tools/lib" includes="*.jar" erroronmissingdir="false">
      <exclude name="glassfish.jar"/>
    </fileset>
    <!-- Legacy support jars hold model validators registered in ad_modelvalidator
         that the ant module chain does not build; Login.batchLogin fails without
         them. Only freight is needed: its legacy jar ships the
         org.eevolution.model.FreightModelValidator stub whose superclass
         org.eevolution.freight.model.validator.Freight is compiled in-tree above.
         Other legacy jars are deliberately excluded: they carry 2022 copies of
         org.eevolution.model.MWM* models that make unqualified Scala imports
         ambiguous against org.eevolution.wms.model. -->
    <fileset dir="${basedir}/../tools/lib/legacy" includes="freight-support-legacy-*.jar" erroronmissingdir="false"/>
    <!-- Model validators shipped only as prebuilt module jars in the installed app
         tree, never as sources in this repository. Login.batchLogin reads
         ad_modelvalidator and Class.forName's every active row, so a registered
         validator missing from the classpath fails the login that every spec
         performs. These two are the ones this instance registers and no other
         path provides:
           org.eevolution.model.GRPAccountValidator                     -> GRP.jar
           org.eevolution.context.service.domain.validators.Contract...  -> service-management
         Only these are included, never the whole packages tree: the other module
         jars ship a bundled scala-library, which makes dotty abort with
         "package scala contains object and package with same name: caps", and
         duplicate org.eevolution.model.MWM* models that make unqualified Scala
         imports ambiguous. Guarded so a database that does not register them, or
         a tree without an install step, still runs. Override the app home with
         -Dscala.adempiere.home=/path/to/Adempiere or export ADEMPIERE_HOME. -->
    <fileset dir="${scala.adempiere.home}/packages/GovernmentManagement/lib"
             includes="GRP.jar" erroronmissingdir="false"/>
    <fileset dir="${scala.adempiere.home}/packages/ServiceManagement/lib"
             includes="org.eevolution.service-management-*.jar" erroronmissingdir="false"/>
  </path>

  <path id="scala.libs.path">
    <fileset dir="${scala.deps.dir}">
      <include name="scala3-library_3-*.jar"/>
      <include name="scala-library-*.jar"/>
      <include name="scalatest_3-*.jar"/>
      <include name="scalatest-core_3-*.jar"/>
      <include name="scalatest-featurespec_3-*.jar"/>
      <include name="scalatest-compatible-*.jar"/>
      <include name="scalactic_3-*.jar"/>
      <include name="scala-xml_3-*.jar"/>
    </fileset>
  </path>

  <!-- Fail early with guidance when the java classes are not available. -->
  <target name="scala-java-classes" description="Check the java classes the specs need are available">
    <!-- Surface the resolved app home and whether the prebuilt validator jars made it
         onto the classpath. Login.batchLogin returns false without throwing, so a
         validator jar silently left off the path shows up as "batchLogin failed" with
         no cause anywhere in the log. Both are reported through <condition> with an
         explicit else: an unset property would otherwise echo the literal token, which
         reads like a broken build on a runner that simply has no install output. -->
    <condition property="scala.home.resolved" value="yes" else="no">
      <available file="${scala.adempiere.home}/packages" type="dir"/>
    </condition>
    <condition property="scala.grp.present" value="yes" else="no">
      <available file="${scala.adempiere.home}/packages/GovernmentManagement/lib/GRP.jar"/>
    </condition>
    <echo message="scala.adempiere.home=${scala.adempiere.home} (install output present: ${scala.home.resolved})"/>
    <echo message="GRP.jar on classpath: ${scala.grp.present}"/>
    <condition property="scala.app.classes.missing">
      <not><available classname="org.compiere.model.MProduct" classpath="${scala.app.classes}"/></not>
    </condition>
    <fail if="scala.app.classes.missing" message="scala.app.classes not found: ${scala.app.classes}${line.separator}Run the java build first (ant -f utils_dev/build.xml jar) or point -Dscala.app.classes to a compiled tree."/>
    <!-- ad_modelvalidator row 50027 registers org.eevolution.model.FreightModelValidator,
         whose superclass org.eevolution.freight.model.validator.Freight lives in the
         org.eevolution.freight module (outside the utils_dev jar chain). Login.batchLogin
         aborts the JVM silently without it. The legacy jar ships it, so the module is only
         compiled when that jar is absent AND the sources are here: recompiling it whenever
         its sources happen to be present fails in a linked worktree, whose own module build
         directories are empty, even though the classes already resolve on the classpath. -->
    <condition property="scala.freight.needed">
      <and>
        <not><available classname="org.eevolution.freight.model.validator.Freight" classpath="${scala.app.classes}"/></not>
        <not><available file="${basedir}/../tools/lib/legacy/freight-support-legacy-1.0.0.jar"/></not>
      </and>
    </condition>
    <antcall target="scala-freight-classes"/>
    <condition property="scala.freight.missing">
      <and>
        <not><available classname="org.eevolution.freight.model.validator.Freight" classpath="${scala.app.classes}"/></not>
        <not><available file="${basedir}/../tools/lib/legacy/freight-support-legacy-1.0.0.jar"/></not>
      </and>
    </condition>
    <fail if="scala.freight.missing" message="org.eevolution.freight classes not found.${line.separator}Run: ant -f ${basedir}/../org.eevolution.freight/build.xml compile"/>
  </target>

  <target name="scala-freight-classes" if="scala.freight.needed">
    <echo message="=== compiling org.eevolution.freight (needed by Login.batchLogin) ==="/>
    <ant inheritAll="false" dir="${basedir}/../org.eevolution.freight" target="compile"/>
  </target>

  <target name="scala-compile" depends="scala-deps,scala-java-classes" description="Compile all scala sources of this module">
    <pathconvert property="scala.compile.cp.stage1" pathsep=":" refid="scala.app.path"/>
    <pathconvert property="scala.libs.cp" pathsep=":" refid="scala.libs.path"/>
    <pathconvert property="scala.main.srcs.list" pathsep=" ">
      <fileset dir="src/main/scala" includes="**/*.scala"/>
    </pathconvert>
    <pathconvert property="scala.test.srcs.list" pathsep=" ">
      <fileset dir="src/test/scala" includes="**/*.scala"/>
    </pathconvert>
    <echo message="=== scalac stage 1: src/main/scala ==="/>
    <java classname="dotty.tools.dotc.Main" fork="true" failonerror="true"
          jvm="${scala.java.bin}/java" maxmemory="1024m">
      <classpath refid="scala.compiler.path"/>
      <arg value="-classpath"/>
      <arg value="${scala.compile.cp.stage1}:${scala.libs.cp}"/>
      <arg value="-d"/>
      <arg value="${scala.main.classes}"/>
      <arg line="${scala.main.srcs.list}"/>
    </java>
    <echo message="=== scalac stage 2: src/test/scala ==="/>
    <java classname="dotty.tools.dotc.Main" fork="true" failonerror="true"
          jvm="${scala.java.bin}/java" maxmemory="1024m">
      <classpath refid="scala.compiler.path"/>
      <arg value="-classpath"/>
      <arg value="${scala.compile.cp.stage1}:${scala.main.classes}:${scala.libs.cp}"/>
      <arg value="-d"/>
      <arg value="${scala.test.classes}"/>
      <arg line="${scala.test.srcs.list}"/>
    </java>
    <echo message="=== scala-compile OK ==="/>
  </target>

  <!-- Prepare the writable test property file from the committed template. -->
  <target name="scala-test-config" description="Copy the test connection template to the gitignored working file">
    <copy file="${scala.test.template}" tofile="${scala.test.propertyfile}" overwrite="false"/>
  </target>

  <!-- Run ScalaTest suites. Filter with -Dscala.test.suites=org.eevolution.test.Foo -->
  <target name="scala-test" depends="scala-compile,scala-test-config" description="Run the ScalaTest suites">
    <!-- ScalaTest takes one suite per -s, so a comma-separated list has to become
         repeated flags. A plain "-s ${scala.test.suites}" would hand the Runner a single
         argument still holding the commas and fail to load any suite. -->
    <loadresource property="scala.runner.suitelist">
      <string value="${scala.test.suites}"/>
      <filterchain>
        <replaceregex pattern="\s*,\s*" replace=" -s " flags="g"/>
        <trim/>
      </filterchain>
    </loadresource>
    <condition property="scala.runner.suites" value="-s ${scala.runner.suitelist}" else="">
      <not><equals arg1="${scala.test.suites}" arg2=""/></not>
    </condition>
    <pathconvert property="scala.runner.runpath" pathsep="," refid="scala.app.path"/>
    <java classname="org.scalatest.tools.Runner" fork="true" failonerror="true"
          jvm="${scala.java.bin}/java" maxmemory="1024m" dir="${basedir}">
      <classpath>
        <pathelement location="${scala.test.classes}"/>
        <pathelement location="${scala.main.classes}"/>
        <path refid="scala.app.path"/>
        <path refid="scala.libs.path"/>
      </classpath>
      <sysproperty key="PropertyFile" file="${scala.test.propertyfile}"/>
      <env key="ADEMPIERE_APPS_TYPE" value="${scala.test.apps.type}"/>
      <arg value="-R"/>
      <arg value="${scala.runner.runpath},${scala.main.classes},${scala.test.classes}"/>
      <arg value="-o"/>
      <arg line="${scala.runner.suites}"/>
    </java>
    <echo message="=== scala-test OK ==="/>
  </target>

  <target name="scala-clean" description="Remove scala build outputs (keeps downloaded jars)">
    <delete dir="${scala.main.classes}"/>
    <delete dir="${scala.test.classes}"/>
  </target>

  <target name="scala-clean-all" depends="scala-clean" description="Also remove downloaded scala jars">
    <delete dir="${scala.deps.dir}"/>
  </target>

</project>
