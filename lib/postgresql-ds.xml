<datasources>
    <datasource jta="true" jndi-name="java:/AdempiereDS" pool-name="AdempiereDS" enabled="true" use-ccm="true" use-java-context="false">
        <connection-url>@ADEMPIERE_DB_URL@</connection-url>
        <driver-class>@@JDBC_DRIVER_CLASS@@</driver-class>
        <driver>AdempiereSLib.jar</driver>
        <connection-property name="ApplicationName">ADempiere AdempiereDS</connection-property>
        <transaction-isolation>TRANSACTION_READ_COMMITTED</transaction-isolation>
        <pool>
            <min-pool-size>11</min-pool-size>
            <max-pool-size>50</max-pool-size>
            <prefill>true</prefill>
        </pool>
        <security>
            <user-name>@ADEMPIERE_DB_USER@</user-name>
            <password>@ADEMPIERE_DB_PASSWORD@</password>
        </security>
        <validation>
            <valid-connection-checker class-name="org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker"/>
            <background-validation>true</background-validation>
            <background-validation-millis>30000</background-validation-millis>
            <use-fast-fail>true</use-fast-fail>
            <exception-sorter class-name="org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter"/>
        </validation>
        <statement>
            <prepared-statement-cache-size>64</prepared-statement-cache-size>
            <share-prepared-statements>true</share-prepared-statements>
        </statement>
    </datasource>
    <datasource jta="true" jndi-name="java:/AdempiereSRDS" pool-name="AdempiereSRDS" enabled="true" use-ccm="true" use-java-context="false">
        <connection-url>@ADEMPIERE_DB_URL@</connection-url>
        <driver-class>@@JDBC_DRIVER_CLASS@@</driver-class>
        <driver>AdempiereSLib.jar</driver>
        <connection-property name="ApplicationName">ADempiere AdempiereSRDS</connection-property>
        <connection-property name="readOnly">true</connection-property>
        <connection-property name="readOnlyMode">always</connection-property>
        <transaction-isolation>TRANSACTION_READ_COMMITTED</transaction-isolation>
        <pool>
            <min-pool-size>11</min-pool-size>
            <max-pool-size>20</max-pool-size>
            <prefill>true</prefill>
        </pool>
        <security>
            <user-name>@ADEMPIERE_DB_USER@</user-name>
            <password>@ADEMPIERE_DB_PASSWORD@</password>
        </security>
        <validation>
            <valid-connection-checker class-name="org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker"/>
            <background-validation>true</background-validation>
            <background-validation-millis>30000</background-validation-millis>
            <use-fast-fail>true</use-fast-fail>
            <exception-sorter class-name="org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter"/>
        </validation>
    </datasource>
</datasources>